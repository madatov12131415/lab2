{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result_task_2 schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ID",
      "vendor_release_date",
      "vendor_release_url",
      "url",
      "published_date",
      "updated_date",
      "description",
      "cvss_list",
      "cpe_list",
      "cwe"
    ],
    "properties": {
      "ID": {
        "type": "string",
        "minLength": 1
      },
      "vendor_release_date": {
        "type": "string",
        "minLength": 1
      },
      "vendor_release_url": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "published_date": {
        "type": "string",
        "minLength": 1
      },
      "updated_date": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "cvss_list": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "score",
            "vector",
            "severity"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "score": {
              "type": ["number", "integer", "null"]
            },
            "vector": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            }
          }
        }
      },
      "cpe_list": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "cwe": {
        "type": "object",
        "patternProperties": {
          "^CWE-[0-9]+$": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
